# ============================================================
# FRAUD AGENT — API KEYS TEMPLATE
# Copy this file to .env and fill in your keys
# ============================================================

# Google Gemini (REQUIRED)
# Get from: https://aistudio.google.com/app/apikey
GEMINI_API_KEY=your_gemini_api_key_here

# Tavily Search (REQUIRED — general web search)
# Get from: https://app.tavily.com
TAVILY_API_KEY=your_tavily_api_key_here

# Serper (REQUIRED — Google search for SEC/court searches)
# Get from: https://serper.dev
SERPER_API_KEY=your_serper_api_key_here

# Groq (OPTIONAL — fallback model if primary rate-limits)
# Get from: https://console.groq.com/keys
GROQ_API_KEY=your_groq_api_key_here

# LangSmith (OPTIONAL — for tracing/debugging)
# Get from: https://smith.langchain.com
LANGSMITH_API_KEY=your_langsmith_api_key_here
LANGSMITH_PROJECT=fraud-agent

# OpenSanctions (OPTIONAL — sanctions watchlist checks)
OPENSANCTIONS_API_KEY=your_opensanctions_api_key_here

# ── Databases (OPTIONAL — app works without these) ─────────

# MongoDB Atlas (free tier)
# Get from: https://www.mongodb.com/cloud/atlas
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/

# Neo4j Aura (free tier)
# Get from: https://neo4j.com/cloud/aura/
NEO4J_URI=neo4j+ssc://xxxxxxxx.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j
